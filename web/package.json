{
  "name": "gsc-cli-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/sync-reference.mjs && next build",
    "build:cloudflare": "node scripts/sync-reference.mjs && next build --webpack && node scripts/prepare-cloudflare-assets.mjs gsc-cli",
    "deploy:cloudflare": "wrangler deploy",
    "dev": "node scripts/sync-reference.mjs && next dev",
    "start": "serve out",
    "types:check": "node scripts/sync-reference.mjs && fumadocs-mdx && next typegen && tsc --noEmit",
    "test:search": "node scripts/check-search.mjs",
    "test:llms": "node scripts/check-llms.mjs",
    "bundle:analyze": "next analyze --output",
    "bundle:export": "next analyze export"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.2.0",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "4.153.0"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "26.x"
  }
}
